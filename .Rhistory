library(geosphere)
library(tidyverse)
# Coordenadas aproximadas de los aeropuertos
bogota  <- c(-74.1469, 4.7016)   # El Dorado (BOG) - Altitud 2548m
popayan <- c(-76.6094, 2.4544)   # Guillermo León Valencia (PPN) - Altitud 1733m
# 1. Calcular distancia de ruta (Línea recta / Gran Círculo)
distancia_km <- distHaversine(bogota, popayan) / 1000
# 2. Simular puntos de posición cada minuto (Duración ~50 minutos en ATR-72)
tiempo_minutos <- 0:50
puntos_ruta <- gcIntermediate(bogota, popayan, n = 49, addStartEnd = TRUE)
simulacion_vuelo <- tibble(
minuto    = tiempo_minutos,
longitud  = puntos_ruta[, 1],
latitud   = puntos_ruta[, 2],
# Perfil de altitud (Ascenso a 24,000 ft / 7,300 m, Crucero y Descenso)
altitud_ft = c(
seq(8360, 24000, length.out = 15), # Ascenso
rep(24000, 21),                     # Crucero sobre los Andes
seq(24000, 5686, length.out = 15)  # Descenso hacia Popayán
)
)
head(simulacion_vuelo)
