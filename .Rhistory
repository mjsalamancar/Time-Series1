# Cargar librerías necesarias
library(tidyverse)
library(lubridate)
# 1. Parámetros de la simulación
set.seed(123) # Para hacer los resultados reproducibles
fecha_inicio <- as.Date("2021-01-01")
fecha_fin    <- as.Date("2024-12-31")
# 2. Generar secuencia de fechas
datos_pasajeros <- tibble(
fecha = seq.Date(from = fecha_inicio, to = fecha_fin, by = "day")
) %>%
mutate(
anio        = year(fecha),
mes         = month(fecha),
dia_semana  = wday(fecha, label = TRUE, abbr = FALSE, week_start = 1),
dia_anio    = yday(fecha)
)
# 3. Componentes de la serie de tiempo
datos_pasajeros <- datos_pasajeros %>%
mutate(
# Tendencia: Crecimiento constante de la ruta a lo largo de los 4 años
tendencia = as.numeric(fecha - fecha_inicio) * 0.05,
# Estacionalidad semanal (ponderación por día)
efecto_dia = case_when(
dia_semana == "lunes"     ~ 15,
dia_semana == "martes"    ~ -10,
dia_semana == "miércoles" ~ -5,
dia_semana == "jueves"    ~ 5,
dia_semana == "viernes"   ~ 25,
dia_semana == "sábado"    ~ -15,
dia_semana == "domingo"   ~ 20
),
# Estacionalidad anual (picos en dic/ene y jun/jul)
efecto_mes = 30 * sin(2 * pi * (dia_anio - 80) / 365.25),
# Pico de Semana Santa (aproximadamente en marzo/abril)
es_semana_santa = if_else(mes %in% c(3, 4) & mday(fecha) %in% 10:20, 35, 0),
# Ruido aleatorio (variaciones diarias inesperadas)
ruido = rnorm(n(), mean = 0, sd = 15),
# 4. Cálculo final de pasajeros (Promedio base de ~180 pasajeros/día)
pasajeros_base = 180 + tendencia + efecto_dia + efecto_mes + es_semana_santa + ruido,
# Redondear y asegurar que no haya valores negativos
pasajeros = pmax(0, round(pasajeros_base))
) %>%
# Limpiar columnas intermedias si solo quieres la serie
select(fecha, anio, mes, dia_semana, pasajeros)
# --- VISUALIZACIÓN Y RESUMEN ---
# Ver primeras filas
head(datos_pasajeros)
# Resumen estadístico
summary(datos_pasajeros$pasajeros)
# Gráfico de la serie de tiempo diaria
ggplot(datos_pasajeros, aes(x = fecha, y = pasajeros)) +
geom_line(color = "#ec4899", alpha = 0.7) +
geom_smooth(method = "gam", color = "#831843", se = FALSE) +
labs(
title = "Simulación: Pasajeros Diarios Bogotá - Popayán (4 Años)",
subtitle = "Incluye tendencia, estacionalidad semanal y picos de temporada alta",
x = "Fecha",
y = "Número de Pasajeros"
) +
theme_minimal()
